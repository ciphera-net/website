# ciphera-website environment variables
#
# NEXT_PUBLIC_* values are inlined into the client JavaScript bundle by
# `next build`. They MUST be set at build time:
#   - In CI: via `build-args:` in .github/workflows/build-and-push.yml
#   - In local dev: via `.env.local` (copy this file to .env.local first)
#
# Values prefixed with NEXT_PUBLIC_ end up in the browser and are NOT secret.
# Anything secret (API keys, tokens) must NOT be prefixed with NEXT_PUBLIC_
# and must be read only by server-side code.
#
# scripts/validate-env.mjs enforces that required vars are set at build time
# and fails the build loudly if not — no more silent `undefined` placeholders
# shipping to production.

# -------- REQUIRED at build time --------

# website-backend base URL. Used by the /contact page to POST contact form
# submissions to /api/v1/contact. If unset, the browser tries to POST to
# "undefined/api/v1/contact", which resolves to a path under the current
# origin and 404s at the CDN — this was the 11-04-2026 contact form outage.
# Prod: https://api.ciphera.net
# Dev:  http://localhost:8084
NEXT_PUBLIC_WEBSITE_API_URL=https://api.ciphera.net

# Captcha service base URL (includes /api/v1 suffix). Passed to the
# <CaptchaWidget> on the contact form. If unset the widget silently breaks.
# Prod: https://captcha.ciphera.net/api/v1
# Dev:  http://localhost:8083/api/v1
NEXT_PUBLIC_CAPTCHA_API_URL=https://captcha.ciphera.net/api/v1

# -------- OPTIONAL (source has safe defaults) --------

# Pulse analytics script URL. app/layout.tsx uses it for dns-prefetch;
# it falls back to the prod URL if missing so the root layout never throws.
# NEXT_PUBLIC_PULSE_SCRIPT_URL=https://pulse.ciphera.net/script.js

# Pulse analytics API URL. Same story — safe fallback to prod.
# NEXT_PUBLIC_PULSE_API_URL=https://pulse-api.ciphera.net

# -------- Legacy (may still be read by some tooling) --------

# GitHub Packages auth token for @ciphera-net/ui at install time. In CI this
# is injected via BuildKit secret mount from GH_PACKAGES_READ_TOKEN instead.
# NODE_AUTH_TOKEN=
